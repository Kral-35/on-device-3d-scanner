# Optional. Where the app fetches the DA3 .pte file from.
# Defaults to the Hugging Face repo, so you do not need this file to run the app.
#
# Set it when you have exported the model yourself and want to serve it locally:
#   python export/export_da3.py --stage export --views 8 --height 560 --width 420
#   python export/export_da3.py --stage export-coreml --views 8 --height 560 --width 420
#   python3 -m http.server 8765 --directory export/pte
# The app appends /coreml/... on iOS and /xnnpack/... on Android, matching the
# folder layout under export/pte.
#
# Use your Mac's LAN IP (not localhost) when running on a physical device.
EXPO_PUBLIC_MODEL_BASE=http://192.168.1.100:8765
